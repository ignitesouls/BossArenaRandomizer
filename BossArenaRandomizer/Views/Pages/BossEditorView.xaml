<UserControl x:Class="BossArenaRandomizer.Views.Pages.BossEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#171720"/>
        <SolidColorBrush x:Key="InputBrush" Color="#23232E"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#3B3B4D"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#2A2A38"/>
        <SolidColorBrush x:Key="SelectedBrush" Color="#3A2F57"/>
        <SolidColorBrush x:Key="SelectedBorderBrush" Color="#C9B4FF"/>
        <SolidColorBrush x:Key="PopupSelectedBrush" Color="#4A3A73"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="White"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A9A9B3"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#D9D9E3"/>

        <Style x:Key="EditorTextBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="EditorComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelectedBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource PopupSelectedBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EditorComboBoxToggleButton" TargetType="ToggleButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter Grid.Column="0"
                                                  Margin="8,0,0,0"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>

                                <Border Grid.Column="1" Background="Transparent">
                                    <Path HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Fill="{StaticResource TextPrimaryBrush}"
                                          Data="M 0 0 L 4 4 L 8 0 Z"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#5A5A72"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource SelectedBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ToggleBorder" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="EditorComboBoxTemplate" TargetType="ComboBox">
            <Grid>
                <ToggleButton x:Name="ToggleButton"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                              Style="{StaticResource EditorComboBoxToggleButton}"
                              ClickMode="Press"
                              Focusable="False">
                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left"/>
                </ToggleButton>

                <Popup x:Name="Popup"
                       Placement="Bottom"
                       IsOpen="{TemplateBinding IsDropDownOpen}"
                       AllowsTransparency="True"
                       Focusable="False"
                       PopupAnimation="Slide">
                    <Grid x:Name="DropDown"
                          MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                          MaxHeight="{TemplateBinding MaxDropDownHeight}">
                        <Border Background="{StaticResource InputBrush}"
                                BorderBrush="{StaticResource InputBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"/>

                        <ScrollViewer Margin="2"
                                      SnapsToDevicePixels="True">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Contained"/>
                        </ScrollViewer>
                    </Grid>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="HasItems" Value="False">
                    <Setter TargetName="DropDown" Property="MinHeight" Value="28"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.7"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="EditorComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource EditorComboBoxItemStyle}"/>
            <Setter Property="Template" Value="{StaticResource EditorComboBoxTemplate}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style x:Key="BossListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="#1D1D27"/>
            <Setter Property="BorderBrush" Value="#343445"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="6"/>
        </Style>

        <Style x:Key="BossListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#F3F3F7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4C4C63"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SelectedBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#77778A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="{Binding Title}"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding Subtitle}"
                           Margin="0,8,0,0"
                           FontSize="14"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Width="780"/>
            </StackPanel>

            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16">
                <StackPanel>
                    <TextBlock Text="{Binding BossCount, StringFormat=Visible Bosses: {0}}"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding SelectedFieldCount, StringFormat=Selected Fields: {0}}"
                               Margin="0,4,0,0"
                               Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding DirtyStatusText}"
                               Margin="0,4,0,0"
                               Foreground="{StaticResource SelectedBorderBrush}"/>
                    <TextBlock Text="{Binding StatusText}"
                               Margin="0,6,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Width="280"/>
                </StackPanel>
            </Border>
        </Grid>

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,18">
            <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="16" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Search" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,10,0,0"
                             Style="{StaticResource EditorTextBoxStyle}"/>

                    <TextBlock Text="Filter Field" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,12,0,0"/>
                    <ComboBox ItemsSource="{Binding FilterFields}"
                              SelectedItem="{Binding SelectedFilterField, Mode=TwoWay}"
                              Margin="0,6,0,0"
                              Style="{StaticResource EditorComboBoxStyle}"/>

                    <TextBlock Text="Filter Value" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,12,0,0"/>
                    <TextBox Text="{Binding FilterValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,6,0,0"
                             Style="{StaticResource EditorTextBoxStyle}"/>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="16" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="File Actions" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <Button Content="Reload From bosses.json"
                            Command="{Binding ReloadCommand}"
                            Margin="0,10,0,0"
                            Height="32"/>
                    <Button Content="Save To bosses.json"
                            Command="{Binding SaveCommand}"
                            Margin="0,10,0,0"
                            Height="32"/>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="16" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Item Actions" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <Button Content="New Boss"
                            Command="{Binding NewBossCommand}"
                            Margin="0,10,0,0"
                            Height="32"/>
                    <Button Content="Duplicate Selected"
                            Command="{Binding DuplicateBossCommand}"
                            Margin="0,10,0,0"
                            Height="32"/>
                    <Button Content="Reset Selected"
                            Command="{Binding ResetSelectedBossCommand}"
                            Margin="0,10,0,0"
                            Height="32"/>
                    <Button Content="Delete Selected"
                            Command="{Binding DeleteSelectedBossCommand}"
                            Margin="0,10,0,0"
                            Height="32"/>
                    <Button Content="Export Selected"
                            Command="{Binding ExportSelectedBossCommand}"
                            Margin="0,10,0,0"
                            Height="32"/>
                    <Button Content="Import Entry JSON"
                            Command="{Binding ImportBossCommand}"
                            Margin="0,10,0,0"
                            Height="32"/>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="16">
                <StackPanel>
                    <TextBlock Text="Notes" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="Known fields like Region and DLC use dropdowns. New BossInfo properties still appear automatically."
                               Margin="0,10,0,0"
                               TextWrapping="Wrap"
                               Foreground="#E5E5EC"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource PanelBrush}"
                    CornerRadius="16"
                    Padding="16"
                    Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Boss List"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>

                    <ListBox Grid.Row="1"
                             Margin="0,14,0,0"
                             ItemsSource="{Binding Bosses}"
                             SelectedItem="{Binding SelectedBoss, Mode=TwoWay}"
                             Style="{StaticResource BossListBoxStyle}"
                             ItemContainerStyle="{StaticResource BossListBoxItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"
                                           Foreground="#F8F8FC"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="{StaticResource PanelBrush}"
                    CornerRadius="16"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Boss Details"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>

                    <Grid Grid.Row="1" Margin="0,14,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Boss Name"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>

                        <TextBox Grid.Column="1"
                                 Text="{Binding SelectedBoss.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource EditorTextBoxStyle}"/>
                    </Grid>

                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SelectedBoss.Fields}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding DisplayName}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0"/>

                                        <ContentControl Grid.Column="1"
                                                        Content="{Binding}">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl">
                                                    <Setter Property="ContentTemplate">
                                                        <Setter.Value>
                                                            <DataTemplate>
                                                                <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         Style="{StaticResource EditorTextBoxStyle}"/>
                                                            </DataTemplate>
                                                        </Setter.Value>
                                                    </Setter>

                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UseDropdown}" Value="True">
                                                            <Setter Property="ContentTemplate">
                                                                <Setter.Value>
                                                                    <DataTemplate>
                                                                        <ComboBox ItemsSource="{Binding Options}"
                                                                                  DisplayMemberPath="Label"
                                                                                  SelectedValuePath="Value"
                                                                                  SelectedValue="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                  Style="{StaticResource EditorComboBoxStyle}"/>
                                                                    </DataTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>