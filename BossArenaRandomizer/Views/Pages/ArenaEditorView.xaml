<UserControl x:Class="BossArenaRandomizer.Views.Pages.ArenaEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#171720"/>
        <SolidColorBrush x:Key="PanelAltBrush" Color="#111118"/>
        <SolidColorBrush x:Key="InputBrush" Color="#20202A"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#C9B4FF"/>
        <SolidColorBrush x:Key="GoldBrush" Color="#F0A43A"/>
        <SolidColorBrush x:Key="TextSoftBrush" Color="#A9A9B3"/>

        <Style x:Key="CompactButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="#2A2A36"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#343445"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#252532"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource CompactButton}">
            <Setter Property="Background" Value="#7B42FF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#343445"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#343445"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          Foreground="{TemplateBinding Foreground}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Padding="{TemplateBinding Padding}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="BoxBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <Grid>
                                                <TextBlock Text="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                           Margin="{TemplateBinding Padding}"
                                                           HorizontalAlignment="Left"
                                                           VerticalAlignment="Center"
                                                           Foreground="White"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Path Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="#E5E5EC"
                                                      Width="8"
                                                      Height="4"
                                                      Stretch="Uniform"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,10,0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#5A5A70"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border Background="{StaticResource InputBrush}"
                                        BorderBrush="#343445"
                                        BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer CanContentScroll="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="PART_Popup" Property="MinHeight" Value="60"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#777783"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="Foreground" Value="#F5F5FA"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#343445"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#7B42FF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#777783"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}"/>
            <Setter Property="BorderBrush" Value="#2A2A36"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Preset Pairings"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="White"/>
                <TextBlock Text="{Binding Subtitle}"
                           Margin="0,8,0,0"
                           FontSize="14"
                           Foreground="{StaticResource TextSoftBrush}"/>
            </StackPanel>

            <Border Grid.Column="1"
                    Background="{StaticResource PanelBrush}"
                    CornerRadius="8"
                    Padding="14"
                    Width="330">
                <StackPanel>
                    <TextBlock Text="{Binding DirtyStatusText}"
                               Foreground="{StaticResource AccentBrush}"
                               FontWeight="Bold"/>
                    <TextBlock Text="{Binding StatusText}"
                               Margin="0,6,0,0"
                               Foreground="{StaticResource TextSoftBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Background="{StaticResource PanelBrush}"
                CornerRadius="8"
                Padding="14"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0"
                          ItemsSource="{Binding PresetFiles}"
                          SelectedItem="{Binding SelectedPresetFile, Mode=TwoWay}"/>

                <Button Grid.Column="1"
                        Content="Load"
                        Command="{Binding LoadPresetCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="10,0,0,0"/>

                <Button Grid.Column="2"
                        Content="Refresh"
                        Command="{Binding RefreshPresetsCommand}"
                        Style="{StaticResource CompactButton}"
                        Margin="8,0,0,0"/>

                <Button Grid.Column="3"
                        Content="Save As"
                        Command="{Binding SaveAsCommand}"
                        Style="{StaticResource CompactButton}"
                        Margin="8,0,0,0"/>

                <TextBlock Grid.Column="4"
                           Text="{Binding SelectedPresetFile}"
                           Foreground="{StaticResource TextSoftBrush}"
                           VerticalAlignment="Center"
                           Margin="14,0,0,0"
                           TextTrimming="CharacterEllipsis"/>

                <Button Grid.Column="5"
                        Content="Restore Backup"
                        Command="{Binding RestoreBackupCommand}"
                        Style="{StaticResource CompactButton}"
                        Margin="8,0,0,0"/>

                <Button Grid.Column="6"
                        Content="Overwrite"
                        Command="{Binding SaveOverwriteCommand}"
                        Style="{StaticResource PrimaryButton}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource PanelBrush}"
                    CornerRadius="8"
                    Padding="14"
                    Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Arenas"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ArenaCount}"
                                   Foreground="{StaticResource GoldBrush}"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <TextBox Grid.Row="1"
                             Text="{Binding ArenaSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,12,0,8"/>

                    <StackPanel Grid.Row="2" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Sort"
                                       Foreground="{StaticResource TextSoftBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding ArenaSortModes}"
                                      SelectedItem="{Binding SelectedArenaSortMode, Mode=TwoWay}"/>
                        </Grid>

                        <CheckBox Content="Show only empty arenas"
                                  IsChecked="{Binding ShowOnlyEmptyArenas, Mode=TwoWay}"
                                  Foreground="White"
                                  Margin="0,10,0,0"/>
                    </StackPanel>

                    <ListBox Grid.Row="3"
                             ItemsSource="{Binding Arenas}"
                             SelectedItem="{Binding SelectedArena, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" Margin="0,0,0,6" Background="#1D1D27" CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="White"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Info}"
                                                   Foreground="{StaticResource TextSoftBrush}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding AllowedCount, StringFormat=Allowed bosses: {0}}"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="{StaticResource PanelBrush}"
                    CornerRadius="8"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Boss Permissions"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                            <TextBlock Text="{Binding SelectedArenaAllowedCount, StringFormat=Allowed in selected arena: {0}}"
                                       Foreground="{StaticResource AccentBrush}"
                                       Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding VisibleBossCount, StringFormat=Visible bosses: {0}}"
                                       Foreground="{StaticResource GoldBrush}"
                                       Margin="0,4,0,0"
                                       FontWeight="SemiBold"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="Select All Filtered"
                                Command="{Binding SelectAllFilteredCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Margin="8,0,0,0"/>
                        <Button Grid.Column="2"
                                Content="Clear All Filtered"
                                Command="{Binding ClearAllFilteredCommand}"
                                Style="{StaticResource CompactButton}"
                                Margin="8,0,0,0"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,14,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Text="{Binding BossSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding BossSortModes}"
                                  SelectedItem="{Binding SelectedBossSortMode, Mode=TwoWay}"
                                  Margin="10,0,0,0"/>
                        <ComboBox Grid.Column="2"
                                  ItemsSource="{Binding BossFilterModes}"
                                  SelectedItem="{Binding SelectedBossFilterMode, Mode=TwoWay}"
                                  Margin="10,0,0,0"/>
                        <Button Grid.Column="3"
                                Content="Allow All"
                                Command="{Binding AllowAllBossesCommand}"
                                Style="{StaticResource CompactButton}"
                                Margin="8,0,0,0"/>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Copy from"
                                   Foreground="{StaticResource TextSoftBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding CopySourceArenas}"
                                  DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedCopySourceArena, Mode=TwoWay}"/>
                        <Button Grid.Column="2"
                                Content="Copy Pairings"
                                Command="{Binding CopyPairingsFromArenaCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Margin="10,0,0,0"/>
                        <Button Grid.Column="3"
                                Content="Clear All"
                                Command="{Binding ClearAllBossesCommand}"
                                Style="{StaticResource CompactButton}"
                                Margin="8,0,0,0"/>
                    </Grid>

                    <ListBox Grid.Row="3"
                             ItemsSource="{Binding Bosses}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsAllowed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,4"
                                          Foreground="White">
                                    <Border Padding="8" Background="#1D1D27" CornerRadius="6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="White"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Info}"
                                                       Foreground="{StaticResource TextSoftBrush}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </CheckBox>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
