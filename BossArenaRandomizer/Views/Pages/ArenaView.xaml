<UserControl x:Class="BossArenaRandomizer.Views.Pages.ArenaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
  <UserControl.Resources>
    <Style x:Key="ClickableRowStyle" TargetType="DataGridRow">
      <Setter Property="MinHeight" Value="42"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="#1D1D27"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#2A2A36"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#1D1D27"/>
        </Trigger>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#343445"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="EditorColumnHeaderStyle" TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#20202A"/>
      <Setter Property="Foreground" Value="#A9A9B3"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="BorderBrush" Value="#343445"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
    <Style x:Key="EditorCellStyle" TargetType="DataGridCell">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="Foreground" Value="White"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="{Binding Title}" FontSize="30" FontWeight="Bold" Foreground="White"/>
        <TextBlock Text="{Binding Subtitle}" Margin="0,6,0,0" FontSize="14" Foreground="#A9A9B3"/>
      </StackPanel>
      <Border Grid.Column="1" Background="#171720" BorderBrush="#2A2A36" BorderThickness="1" CornerRadius="8" Padding="16,10">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding SelectedCount}" FontSize="22" FontWeight="Bold" Foreground="#C9B4FF"/>
          <TextBlock Text=" selected of " Margin="5,5,0,0" Foreground="#A9A9B3"/>
          <TextBlock Text="{Binding TotalCount}" Margin="0,5,0,0" Foreground="#A9A9B3"/>
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="1" Background="#171720" BorderBrush="#2A2A36" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="12"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="180"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="*" MinWidth="240"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <TextBlock Text="Search Arena" Foreground="#A9A9B3"/>
          <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,7,0,0" Height="32"/>
        </StackPanel>

        <StackPanel Grid.Column="2">
          <TextBlock Text="Arena Preset" Foreground="#A9A9B3"/>
          <Grid Margin="0,7,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox ItemsSource="{Binding ArenaPresets}" SelectedItem="{Binding SelectedArenaPreset, Mode=TwoWay}" MinWidth="160"/>
            <Button Grid.Column="1" Content="Load" Command="{Binding LoadPresetCommand}" Padding="14,0" Margin="8,0,0,0"/>
            <Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshPresetsCommand}" Padding="14,0" Margin="8,0,0,0"/>
          </Grid>
        </StackPanel>

        <WrapPanel Grid.Row="2" Grid.ColumnSpan="3">
          <Button Content="Reset" Command="{Binding ResetAllCommand}" Padding="13,7" Margin="0,0,6,0"/>
          <Button Content="Clear" Command="{Binding ClearAllCommand}" Padding="13,7" Margin="0,0,6,0"/>
          <Button Content="Base Game" Command="{Binding SelectBaseGameCommand}" Padding="13,7" Margin="0,0,6,0"/>
          <Button Content="DLC" Command="{Binding SelectDlcCommand}" Padding="13,7" Margin="0,0,6,0"/>
          <Button Content="Save Preset" Command="{Binding SavePresetCommand}" Padding="13,7"/>
        </WrapPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2" Background="#171720" BorderBrush="#2A2A36" BorderThickness="1" CornerRadius="8" Padding="1">
      <DataGrid ItemsSource="{Binding ArenaSelectionsView}"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                HeadersVisibility="Column"
                RowHeaderWidth="0"
                IsReadOnly="True"
                GridLinesVisibility="None"
                Background="#111118"
                Foreground="White"
                BorderThickness="0"
                RowStyle="{StaticResource ClickableRowStyle}"
                CellStyle="{StaticResource EditorCellStyle}"
                ColumnHeaderStyle="{StaticResource EditorColumnHeaderStyle}"
                PreviewMouseLeftButtonDown="SelectionGrid_PreviewMouseLeftButtonDown"
                PreviewKeyDown="SelectionGrid_PreviewKeyDown">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="Use" Width="64">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding IsSelected}" IsHitTestVisible="False" Focusable="False" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Arena" Binding="{Binding Name}" Width="*"/>
          <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="180"/>
          <DataGridTextColumn Header="Region" Binding="{Binding RegionName}" Width="220"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </Grid>
</UserControl>