<UserControl x:Class="BossArenaRandomizer.Views.Pages.GenerateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BossArenaRandomizer.ViewModels"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <DataTemplate DataType="{x:Type vm:GenerationResultLine}">
            <TextBlock Text="{Binding Text}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,4">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#E5E5EC"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                <Setter Property="Foreground" Value="#F0A43A"/>
                                <Setter Property="FontSize" Value="18"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Margin" Value="0,12,0,6"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
        <Style x:Key="ResultsTabStyle" TargetType="TabItem">
            <Setter Property="Background" Value="#20202A"/>
            <Setter Property="Foreground" Value="#A9A9B3"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6,6,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#2A2A36"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#343445"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="{Binding Title}"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="White"/>
                <TextBlock Text="{Binding Subtitle}"
                           Margin="0,8,0,0"
                           FontSize="14"
                           Foreground="#A9A9B3"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Width="180"
                    Height="46"
                    Margin="16,0,0,0"
                    Command="{Binding GenerateCommand}"
                    Background="#7B42FF"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderThickness="0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Content" Value="Generate Batch"/>
                        <Setter Property="IsEnabled" Value="True"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Setter Property="Opacity" Value="0.7"/>
                                <Setter Property="Content" Value="Generating..."/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.65*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#171720" CornerRadius="8" Padding="14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Preset Configuration" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        <Button Grid.Column="1" Content="Refresh Lists" Command="{Binding RefreshAllPresetsCommand}" Padding="12,5"/>
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Configuration" Foreground="#A9A9B3" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Configurations}" SelectedItem="{Binding SelectedConfiguration, Mode=TwoWay}"/>
                        <Button Grid.Column="2" Content="Load All" Command="{Binding LoadConfigurationCommand}" Padding="13,6" Margin="8,0,0,0"/>
                    </Grid>

                    <Grid Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Save As" Foreground="#A9A9B3" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding ConfigurationName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="2" Content="Save Current" Command="{Binding SaveConfigurationCommand}" Padding="13,6" Margin="8,0,0,0"/>
                    </Grid>

                    <WrapPanel Margin="96,7,0,0">
                        <Button Content="Rename" Command="{Binding RenameConfigurationCommand}" Padding="11,5" Margin="0,0,7,0"/>
                        <Button Content="Duplicate" Command="{Binding DuplicateConfigurationCommand}" Padding="11,5" Margin="0,0,7,0"/>
                        <Button Content="Delete" Command="{Binding DeleteConfigurationCommand}" Padding="11,5" Margin="0,0,7,0"/>
                        <Button Content="Open Folder" Command="{Binding OpenConfigurationFolderCommand}" Padding="11,5"/>
                    </WrapPanel>

                    <Border Height="1" Background="#2A2A36" Margin="0,11,0,5"/>

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Arena" Foreground="#A9A9B3" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding ArenaPresets}" SelectedItem="{Binding SelectedArenaPreset, Mode=TwoWay}"/>
                        <Button Grid.Column="2" Content="Apply" Command="{Binding LoadArenaPresetCommand}" Width="70" Margin="8,0,0,0"/>
                    </Grid>

                    <Grid Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Boss" Foreground="#A9A9B3" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding BossPresets}" SelectedItem="{Binding SelectedBossPreset, Mode=TwoWay}"/>
                        <Button Grid.Column="2" Content="Apply" Command="{Binding LoadBossPresetCommand}" Width="70" Margin="8,0,0,0"/>
                    </Grid>

                    <Grid Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Rando Options" Foreground="#A9A9B3" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding OptionsPresets}" SelectedItem="{Binding SelectedOptionsPreset, Mode=TwoWay}"/>
                    </Grid>

                    <Grid Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Pairing" Foreground="#A9A9B3" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding PairingPresets}" SelectedItem="{Binding SelectedPairingPreset, Mode=TwoWay}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="#171720" CornerRadius="8" Padding="14">
                <StackPanel>
                    <TextBlock Text="Output &amp; Batch" FontSize="18" FontWeight="Bold" Foreground="White"/>

                    <TextBlock Text="Output Base Folder" Foreground="#A9A9B3" Margin="0,12,0,0"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding OutputFolderPath}" IsReadOnly="True"/>
                        <Button Grid.Column="1" Content="Choose" Command="{Binding BrowseOutputPathCommand}" Padding="12,6" Margin="8,0,0,0"/>
                        <Button Grid.Column="2" Content="Open" Command="{Binding OpenOutputFolderCommand}" Padding="12,6" Margin="8,0,0,0"/>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Seed Count" Foreground="#A9A9B3"/>
                            <TextBox Text="{Binding SeedCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Replay Seed" Foreground="#A9A9B3"/>
                            <TextBox Text="{Binding ReplaySeedText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="File Name Pattern" Foreground="#A9A9B3" Margin="0,12,0,0"/>
                    <TextBox Text="{Binding FileNamePattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#171720"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,12,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Pairing Tools"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <CheckBox Content="Clear Arenas"
                              IsChecked="{Binding ClearArenasEnabled, Mode=TwoWay}"
                              Margin="0,16,0,0"
                              Foreground="White"/>

                    <TextBlock Text="The selected pairing JSON controls which bosses can appear in each arena."
                              Margin="0,12,0,0"
                              TextWrapping="Wrap"
                              Foreground="#A9A9B3"/>

                    <Button Content="Validate Preset"
                            Command="{Binding ValidatePairingPresetCommand}"
                            Margin="0,16,0,0"
                            Height="34"/>

                    <Button Content="Test Randomization"
                            Command="{Binding DryRunCommand}"
                            Margin="0,8,0,0"
                            Height="34"/>

                    <Button Content="Export Debug Log"
                            Command="{Binding ExportDebugLogCommand}"
                            Margin="0,8,0,0"
                            Height="34"/>

                    <Border Background="#111118"
                            CornerRadius="12"
                            Padding="14"
                            Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="Status"
                                       Foreground="#C9B4FF"
                                       FontWeight="Bold"/>
                            <TextBlock Text="{Binding StatusText}"
                                       Foreground="White"
                                       Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding SeedText}"
                                       Foreground="#C9B4FF"
                                       Margin="0,6,0,0"
                                       FontWeight="Bold"/>
                            <TextBlock Text="{Binding LastGeneratedOutputPath}"
                                       Foreground="#A9A9B3"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>
                            <Button Content="Open Output Folder"
                                    Command="{Binding OpenOutputFolderCommand}"
                                    Margin="0,8,0,0"
                                    Height="32"/>
                            <TextBlock Text="{Binding SelectedArenaCount, StringFormat=Selected Arenas: {0}}"
                                       Foreground="#E5E5EC"
                                       Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding SelectedBossCount, StringFormat=Selected Bosses: {0}}"
                                       Foreground="#E5E5EC"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#111118"
                            CornerRadius="12"
                            Padding="14"
                            Margin="0,22,0,0">
                        <StackPanel>
                            <TextBlock Text="Validation"
                                       Foreground="#C9B4FF"
                                       FontWeight="Bold"/>
                            <ItemsControl ItemsSource="{Binding ValidationLines}"
                                          Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3,0,3"
                                                   Foreground="#E5E5EC"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Background="#111118"
                            CornerRadius="12"
                            Padding="14"
                            Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Uniformity"
                                       Foreground="#C9B4FF"
                                       FontWeight="Bold"/>
                            <ItemsControl ItemsSource="{Binding UniformityLines}"
                                          Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3,0,3"
                                                   Foreground="#E5E5EC"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>
                </ScrollViewer>
            </Border>

            <TabControl Grid.Column="1" Background="Transparent" BorderThickness="0">
                <TabItem Header="Batch Results" Style="{StaticResource ResultsTabStyle}">
                    <Border Background="#171720" CornerRadius="8" Padding="16">
                        <DataGrid ItemsSource="{Binding BatchResults}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="60"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                                <DataGridTextColumn Header="Seed" Binding="{Binding Seed}" Width="120"/>
                                <DataGridTextColumn Header="Output" Binding="{Binding OutputPath}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </TabItem>

                <TabItem Header="Last Assignment" Style="{StaticResource ResultsTabStyle}">
                    <Border Background="#171720" CornerRadius="8" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Last Generated Assignment" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                <Button Grid.Column="1" Command="{Binding ToggleSpoilerCommand}" Padding="14,6" Background="#2A2A36" Foreground="White">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Content" Value="Reveal Spoiler"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSpoilerRevealed}" Value="True">
                                                    <Setter Property="Content" Value="Hide Spoiler"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>

                            <Border Grid.Row="1" Background="#111118" CornerRadius="8" Padding="18" Margin="0,12,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSpoilerRevealed}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="Spoiler hidden" FontSize="18" FontWeight="Bold" Foreground="#C9B4FF" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Use Reveal Spoiler to view the last generated assignment." Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center" Foreground="#E5E5EC"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Background="#111118" CornerRadius="8" Padding="14" Margin="0,12,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSpoilerRevealed}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding ResultLines}"/>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>
                </TabItem>
            </TabControl>        </Grid>

        <Border Background="#B3000000"
                Panel.ZIndex="999"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Border Width="320"
                        Padding="24"
                        CornerRadius="18"
                        Background="#171720"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Generating batch..."
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Please wait while the randomizer builds your output files."
                                   Margin="0,10,0,0"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="#A9A9B3"/>

                        <ProgressBar Margin="0,18,0,0"
                                     Height="18"
                                     IsIndeterminate="True"/>

                        <TextBlock Text="{Binding StatusText}"
                                   Margin="0,14,0,0"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="#C9B4FF"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
