<UserControl x:Class="BossArenaRandomizer.Views.Pages.GenerateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BossArenaRandomizer.ViewModels"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <DataTemplate DataType="{x:Type vm:GenerationResultLine}">
            <TextBlock Text="{Binding Text}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,4">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#E5E5EC"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                <Setter Property="Foreground" Value="#F0A43A"/>
                                <Setter Property="FontSize" Value="18"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Margin" Value="0,12,0,6"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="{Binding Title}"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="White"/>
                <TextBlock Text="{Binding Subtitle}"
                           Margin="0,8,0,0"
                           FontSize="14"
                           Foreground="#A9A9B3"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Width="180"
                    Height="46"
                    Margin="16,0,0,0"
                    Command="{Binding GenerateCommand}"
                    Background="#7B42FF"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderThickness="0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Content" Value="Generate Batch"/>
                        <Setter Property="IsEnabled" Value="True"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Setter Property="Opacity" Value="0.7"/>
                                <Setter Property="Content" Value="Generating..."/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,18">
            <Border Background="#171720" CornerRadius="16" Padding="16" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Options Preset" Foreground="#A9A9B3"/>
                    <ComboBox ItemsSource="{Binding OptionsPresets}"
                              SelectedItem="{Binding SelectedOptionsPreset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Margin="0,10,0,0"/>
                    <Button Content="Refresh"
                            Command="{Binding RefreshOptionsPresetsCommand}"
                            Margin="0,10,0,0"
                            Height="30"/>
                </StackPanel>
            </Border>

            <Border Background="#171720" CornerRadius="16" Padding="16" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Output Base File" Foreground="#A9A9B3"/>
                    <TextBox Text="{Binding OutputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,10,0,0"
                             IsReadOnly="True"/>
                    <Button Content="Choose Output File"
                            Command="{Binding BrowseOutputPathCommand}"
                            Margin="0,10,0,0"
                            Height="30"/>
                </StackPanel>
            </Border>

            <Border Background="#171720" CornerRadius="16" Padding="16" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Batch Setup" Foreground="#A9A9B3"/>
                    <TextBlock Text="Seed Count" Foreground="White" Margin="0,10,0,0"/>
                    <TextBox Text="{Binding SeedCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/>
                    <TextBlock Text="File Name Pattern" Foreground="White" Margin="0,10,0,0"/>
                    <TextBox Text="{Binding FileNamePattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="#171720" CornerRadius="16" Padding="16">
                <StackPanel>
                    <TextBlock Text="Status" Foreground="#A9A9B3"/>
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="White"
                               Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding SeedText}"
                               Foreground="#C9B4FF"
                               Margin="0,6,0,0"
                               FontWeight="Bold"/>
                    <TextBlock Text="{Binding SelectedArenaCount, StringFormat=Selected Arenas: {0}}"
                               Foreground="#E5E5EC"
                               Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding SelectedBossCount, StringFormat=Selected Bosses: {0}}"
                               Foreground="#E5E5EC"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#171720"
                    CornerRadius="16"
                    Padding="18"
                    Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="Restrictions"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <CheckBox Content="Clear Arenas"
                              IsChecked="{Binding ClearArenasEnabled, Mode=TwoWay}"
                              Margin="0,16,0,0"
                              Foreground="White"/>

                    <CheckBox Content="Arena Size Restriction"
                              IsChecked="{Binding ArenaSizeRestrictionEnabled, Mode=TwoWay}"
                              Margin="0,10,0,0"
                              Foreground="White"/>

                    <CheckBox Content="Boss Rush Difficulty Curve"
                              IsChecked="{Binding BossRushDifficultyCurveEnabled, Mode=TwoWay}"
                              Margin="0,10,0,0"
                              Foreground="White"/>

                    <TextBlock Text="Boss Rush Difficulty Curve keeps harder bosses out of easier areas."
                              Margin="0,10,0,0"
                              TextWrapping="Wrap"
                              Foreground="#A9A9B3"/>

                    <CheckBox Content="Loose Difficulty"
                              IsChecked="{Binding LooseDifficultyEnabled, Mode=TwoWay}"
                              Margin="0,10,0,0"
                              Foreground="White"/>

                    <TextBlock Text="Loose Difficulty allows some harder bosses to appear earlier based on pass-through tiers."
                              Margin="0,6,0,0"
                              TextWrapping="Wrap"
                              Foreground="#A9A9B3"/>

                    <Border Background="#111118"
                            CornerRadius="12"
                            Padding="14"
                            Margin="0,22,0,0">
                        <StackPanel>
                            <TextBlock Text="Pattern Tokens"
                                       Foreground="#C9B4FF"
                                       FontWeight="Bold"/>
                            <TextBlock Text="{}{index} = batch number"
                                       Margin="0,10,0,0"
                                       Foreground="#E5E5EC"/>
                            <TextBlock Text="{}{seed} = generated seed"
                                       Margin="0,6,0,0"
                                       Foreground="#E5E5EC"/>
                            <TextBlock Text="{}{preset} = options preset name"
                                       Margin="0,6,0,0"
                                       Foreground="#E5E5EC"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="220"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#171720"
                        CornerRadius="16"
                        Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Batch Results"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <DataGrid Grid.Row="1"
                                  Margin="0,14,0,0"
                                  ItemsSource="{Binding BatchResults}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="60"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                                <DataGridTextColumn Header="Seed" Binding="{Binding Seed}" Width="120"/>
                                <DataGridTextColumn Header="Output" Binding="{Binding OutputPath}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Background="#171720"
                        CornerRadius="16"
                        Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Last Generated Assignment"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <Button Grid.Column="1"
                                    Command="{Binding ToggleSpoilerCommand}"
                                    Padding="14,6"
                                    BorderThickness="0"
                                    Background="#2A2A36"
                                    Foreground="White">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Content" Value="Reveal Spoiler"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSpoilerRevealed}" Value="True">
                                                <Setter Property="Content" Value="Hide Spoiler"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <Border Grid.Row="1"
                                Background="#111118"
                                CornerRadius="12"
                                Padding="18"
                                Margin="0,14,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSpoilerRevealed}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Spoiler hidden"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#C9B4FF"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Click &quot;Reveal Spoiler&quot; to view the last generated assignment."
                                           Margin="0,10,0,0"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Foreground="#E5E5EC"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2"
                                Background="#111118"
                                CornerRadius="12"
                                Padding="14"
                                Margin="0,14,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSpoilerRevealed}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ResultLines}"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Background="#B3000000"
                Panel.ZIndex="999"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Border Width="320"
                        Padding="24"
                        CornerRadius="18"
                        Background="#171720"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Generating batch..."
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Please wait while the randomizer builds your output files."
                                   Margin="0,10,0,0"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="#A9A9B3"/>

                        <ProgressBar Margin="0,18,0,0"
                                     Height="18"
                                     IsIndeterminate="True"/>

                        <TextBlock Text="{Binding StatusText}"
                                   Margin="0,14,0,0"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="#C9B4FF"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>