<UserControl x:Class="BossArenaRandomizer.Views.Pages.AnalyzeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="{Binding Title}"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="White"/>
                <TextBlock Text="{Binding Subtitle}"
                           Margin="0,8,0,0"
                           FontSize="14"
                           Foreground="#A9A9B3"/>
            </StackPanel>

            <Border Grid.Column="1" Background="#171720" CornerRadius="14" Padding="16">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedCheckCount, StringFormat=Selected Checks: {0}}"
                               Foreground="White"/>
                    <TextBlock Text="{Binding StatusText, StringFormat=Status: {0}}"
                               Margin="0,4,0,0"
                               Foreground="#A9A9B3"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Top controls -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,18">
            <Border Background="#171720" CornerRadius="16" Padding="16" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Imported Spoiler Log" Foreground="#A9A9B3"/>
                    <TextBox Text="{Binding ImportedSeedPath}"
                             Margin="0,10,0,0"
                             IsReadOnly="True"/>
                    <Button Content="Import Spoiler Log"
                            Command="{Binding ImportSeedCommand}"
                            Margin="0,10,0,0"
                            Height="32"/>
                </StackPanel>
            </Border>

            <Border Background="#171720" CornerRadius="16" Padding="16" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Run" Foreground="#A9A9B3"/>
                    <Button Content="Run Checks"
                            Command="{Binding RunChecksCommand}"
                            Margin="0,10,0,0"
                            Height="32"/>
                    <Button Content="Clear"
                            Command="{Binding ClearCommand}"
                            Margin="0,10,0,0"
                            Height="32"/>
                </StackPanel>
            </Border>

            <Border Background="#171720" CornerRadius="16" Padding="16">
                <StackPanel>
                    <TextBlock Text="Custom Tests" Foreground="#A9A9B3"/>
                    <TextBlock Text="{Binding CustomCheckCount, StringFormat={}{0} tests}"
                               Margin="0,10,0,0"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="White"/>
                    <TextBlock Text="{Binding CustomCheckEditorStatus}"
                               Margin="0,6,0,0"
                               Foreground="#A9A9B3"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Main area -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="520"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#171720"
                    CornerRadius="16"
                    Padding="12"
                    Margin="0,0,16,0">
                <TabControl Background="Transparent" BorderThickness="0">
                    <TabItem Header="Checks">
                        <ScrollViewer Margin="4,14,4,4"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding CheckOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#111118"
                                                CornerRadius="8"
                                                Padding="12"
                                                Margin="0,0,0,10">
                                            <StackPanel>
                                                <CheckBox Content="{Binding Name}"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          Foreground="White"
                                                          FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Description}"
                                                           Margin="24,6,0,0"
                                                           TextWrapping="Wrap"
                                                           Foreground="#B9B9C5"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="O Mother Lines">
                        <Grid Margin="4,12,4,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Phrases used by the built-in O Mother check"
                                           Foreground="#A9A9B3"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding LineEditorStatus}"
                                           Foreground="#C9B4FF"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding AnalysisLines}"
                                      SelectedItem="{Binding SelectedAnalysisLine, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      HeadersVisibility="None"
                                      SelectionUnit="FullRow"
                                      RowHeight="58"
                                      Margin="0,10,0,10">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         MinHeight="42"
                                                         Padding="8"
                                                         VerticalContentAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <WrapPanel>
                                    <Button Content="Add" Command="{Binding AddAnalysisLineCommand}" Padding="12,6" Margin="0,0,7,0"/>
                                    <Button Content="Delete" Command="{Binding DeleteAnalysisLineCommand}" Padding="12,6" Margin="0,0,7,0"/>
                                    <Button Content="Up" Command="{Binding MoveAnalysisLineUpCommand}" Padding="12,6" Margin="0,0,7,0"/>
                                    <Button Content="Down" Command="{Binding MoveAnalysisLineDownCommand}" Padding="12,6"/>
                                </WrapPanel>
                                <WrapPanel Grid.Column="1" Margin="12,0,0,0">
                                    <Button Content="Restore Defaults" Command="{Binding RestoreDefaultAnalysisLinesCommand}" Padding="12,6" Margin="0,0,7,0"/>
                                    <Button Content="Save Lines" Command="{Binding SaveAnalysisLinesCommand}" Padding="12,6"/>
                                </WrapPanel>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Custom Tests">
                        <Grid Margin="4,12,4,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Search spoiler-log lines and decide whether a match is valid"
                                           Foreground="#A9A9B3"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding CustomCheckEditorStatus}"
                                           Foreground="#C9B4FF"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding CustomChecks}"
                                      SelectedItem="{Binding SelectedCustomCheck, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      HeadersVisibility="Column"
                                      SelectionUnit="FullRow"
                                      Margin="0,10,0,10">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Name" Width="125">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Padding="6"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Search line" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         TextWrapping="Wrap"
                                                         MinHeight="42"
                                                         Padding="6"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Result" Width="145">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding DataContext.CustomTestOutcomes, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                          SelectedItem="{Binding MatchOutcome, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Padding="4"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <WrapPanel>
                                    <Button Content="Add" Command="{Binding AddCustomCheckCommand}" Padding="12,6" Margin="0,0,7,0"/>
                                    <Button Content="Delete" Command="{Binding DeleteCustomCheckCommand}" Padding="12,6" Margin="0,0,7,0"/>
                                    <Button Content="Up" Command="{Binding MoveCustomCheckUpCommand}" Padding="12,6" Margin="0,0,7,0"/>
                                    <Button Content="Down" Command="{Binding MoveCustomCheckDownCommand}" Padding="12,6"/>
                                </WrapPanel>
                                <Button Grid.Column="1"
                                        Content="Save Tests"
                                        Command="{Binding SaveCustomChecksCommand}"
                                        Padding="12,6"
                                        Margin="12,0,0,0"/>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- Results -->
            <Border Grid.Column="1"
                    Background="#171720"
                    CornerRadius="16"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Results"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="{Binding StatusText}"
                                   Margin="0,8,0,0"
                                   Foreground="#C9B4FF"
                                   FontWeight="Bold"/>
                    </StackPanel>

                    <Border Grid.Row="1"
                            Background="#111118"
                            CornerRadius="12"
                            Padding="14"
                            Margin="0,14,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding ResultsText}"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="#E5E5EC"
                                     VerticalScrollBarVisibility="Disabled"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
