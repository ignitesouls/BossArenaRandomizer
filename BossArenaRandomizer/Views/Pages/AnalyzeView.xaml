<UserControl x:Class="BossArenaRandomizer.Views.Pages.AnalyzeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="{Binding Title}"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="White"/>
                <TextBlock Text="{Binding Subtitle}"
                           Margin="0,8,0,0"
                           FontSize="14"
                           Foreground="#A9A9B3"/>
            </StackPanel>

            <Border Grid.Column="1" Background="#171720" CornerRadius="14" Padding="16">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedCheckCount, StringFormat=Selected Checks: {0}}"
                               Foreground="White"/>
                    <TextBlock Text="{Binding StatusText, StringFormat=Status: {0}}"
                               Margin="0,4,0,0"
                               Foreground="#A9A9B3"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Top controls -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,18">
            <Border Background="#171720" CornerRadius="16" Padding="16" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Imported Spoiler Log" Foreground="#A9A9B3"/>
                    <TextBox Text="{Binding ImportedSeedPath}"
                             Margin="0,10,0,0"
                             IsReadOnly="True"/>
                    <Button Content="Import Spoiler Log"
                            Command="{Binding ImportSeedCommand}"
                            Margin="0,10,0,0"
                            Height="32"/>
                </StackPanel>
            </Border>

            <Border Background="#171720" CornerRadius="16" Padding="16" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Run" Foreground="#A9A9B3"/>
                    <Button Content="Run Checks"
                            Command="{Binding RunChecksCommand}"
                            Margin="0,10,0,0"
                            Height="32"/>
                    <Button Content="Clear"
                            Command="{Binding ClearCommand}"
                            Margin="0,10,0,0"
                            Height="32"/>
                </StackPanel>
            </Border>

            <Border Background="#171720" CornerRadius="16" Padding="16">
                <StackPanel>
                    <TextBlock Text="Current Flow" Foreground="#A9A9B3"/>
                    <TextBlock Text="1. Import a generated seed file"
                               Margin="0,10,0,0"
                               Foreground="#E5E5EC"/>
                    <TextBlock Text="2. Select one or more checks"
                               Margin="0,6,0,0"
                               Foreground="#E5E5EC"/>
                    <TextBlock Text="3. Run checks and review the output"
                               Margin="0,6,0,0"
                               Foreground="#E5E5EC"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Main area -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Checks -->
            <Border Grid.Column="0"
                    Background="#171720"
                    CornerRadius="16"
                    Padding="16"
                    Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Available Checks"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <ScrollViewer Grid.Row="1"
                                  Margin="0,14,0,0"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CheckOptions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#111118"
                                            CornerRadius="12"
                                            Padding="12"
                                            Margin="0,0,0,10">
                                        <StackPanel>
                                            <CheckBox Content="{Binding Name}"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Foreground="White"
                                                      FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Description}"
                                                       Margin="24,6,0,0"
                                                       TextWrapping="Wrap"
                                                       Foreground="#B9B9C5"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Results -->
            <Border Grid.Column="1"
                    Background="#171720"
                    CornerRadius="16"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Results"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="{Binding StatusText}"
                                   Margin="0,8,0,0"
                                   Foreground="#C9B4FF"
                                   FontWeight="Bold"/>
                    </StackPanel>

                    <Border Grid.Row="1"
                            Background="#111118"
                            CornerRadius="12"
                            Padding="14"
                            Margin="0,14,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding ResultsText}"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="#E5E5EC"
                                     VerticalScrollBarVisibility="Disabled"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>