<UserControl x:Class="BossArenaRandomizer.Views.Pages.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Image Source="/BossArenaRandomizer;component/Assets/Ignite Logo.png"
                   Width="82"
                   Height="82"
                   Stretch="Uniform"
                   Margin="0,0,18,0"/>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Boss Arena Randomizer"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="White"/>
                <TextBlock Text="{Binding Subtitle}"
                           Margin="0,8,0,0"
                           FontSize="14"
                           Foreground="#A9A9B3"/>
            </StackPanel>
        </Grid>

        <!-- Top stat cards -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,20">
            <Border Background="#171720" CornerRadius="8" Padding="18" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Selected Arenas" Foreground="#A9A9B3"/>
                    <TextBlock Text="{Binding SelectedArenaCount}"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="#171720" CornerRadius="8" Padding="18" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Selected Bosses" Foreground="#A9A9B3"/>
                    <TextBlock Text="{Binding SelectedBossCount}"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="#171720" CornerRadius="8" Padding="18" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Options Preset" Foreground="#A9A9B3"/>
                    <TextBlock Text="{Binding SelectedOptionsPreset}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Background="#171720" CornerRadius="8" Padding="18">
                <StackPanel>
                    <TextBlock Text="Last Status" Foreground="#A9A9B3"/>
                    <TextBlock Text="{Binding LastStatusText}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#C9B4FF"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Main content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="0.8*"/>
            </Grid.ColumnDefinitions>

            <!-- Left content -->
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <Border Background="#171720" CornerRadius="8" Padding="18" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Current Output File"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="{Binding OutputPath}"
                                   Margin="0,12,0,0"
                                   Foreground="#E5E5EC"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Background="#171720" CornerRadius="8" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Last Generation"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="{Binding LastSeedText}"
                                   Margin="0,12,0,0"
                                   Foreground="#C9B4FF"
                                   FontWeight="Bold"/>
                        <TextBlock Text="{Binding LastStatusText}"
                                   Margin="0,8,0,0"
                                   Foreground="#E5E5EC"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Right content -->
            <Border Grid.Column="1" Background="#171720" CornerRadius="8" Padding="18">
                <StackPanel>
                    <TextBlock Text="Quick Actions"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <Button Content="Go to Generate"
                            Command="{Binding GoToGenerateCommand}"
                            Margin="0,16,0,0"
                            Height="40"/>

                    <Button Content="Edit Arenas"
                            Command="{Binding GoToArenasCommand}"
                            Margin="0,10,0,0"
                            Height="40"/>

                    <Button Content="Edit Bosses"
                            Command="{Binding GoToBossesCommand}"
                            Margin="0,10,0,0"
                            Height="40"/>

                    <Button Content="Preset Pairings"
                            Command="{Binding GoToPresetPairingsCommand}"
                            Margin="0,10,0,0"
                            Height="40"
                            Background="#7B42FF"/>

                    <Button Content="Analyze Seed"
                            Command="{Binding GoToAnalyzeCommand}"
                            Margin="0,10,0,0"
                            Height="40"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
