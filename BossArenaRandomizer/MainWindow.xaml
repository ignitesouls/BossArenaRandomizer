<Window x:Class="BossArenaRandomizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:BossArenaRandomizer.ViewModels"
        xmlns:views="clr-namespace:BossArenaRandomizer.Views.Pages"
        mc:Ignorable="d"
        Title="Boss Arena Randomizer"
        Height="800"
        Width="1320"
        MinHeight="700"
        MinWidth="1100"
        Background="#0D0D12"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:GenerateViewModel}">
            <views:GenerateView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:ArenaViewModel}">
            <views:ArenaView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:BossViewModel}">
            <views:BossView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:AnalyzeViewModel}">
            <views:AnalyzeView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:ArenaEditorViewModel}">
            <views:ArenaEditorView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:BossEditorViewModel}">
            <views:BossEditorView />
        </DataTemplate>

        <Style TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Background" Value="#1C1C25"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#7B42FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A2A36"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" Value="#7B42FF"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#14141B"
                BorderBrush="#242430"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="16">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                    <TextBlock Text="Boss Arena"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock Text="Randomizer"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#9E74FF"/>
                    <TextBlock Text="Seed builder and editor"
                               Margin="0,8,0,0"
                               Foreground="#A9A9B3"/>
                </StackPanel>

                <ListBox ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedNavigationItem}"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="White"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}"
                                       FontSize="15"
                                       FontWeight="SemiBold"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Background="#0D0D12">
            <ContentControl Content="{Binding CurrentPageViewModel}"
                            Margin="24"/>
        </Grid>
    </Grid>
</Window>